# ---------------------------------------------------------------------------
# Bürgerportal – Umgebungsvariablen
# Kopieren nach .env.local und anpassen. NIEMALS Schlüssel committen.
# ---------------------------------------------------------------------------

# Gemeinde, wenn keine Subdomain erkannt wird (z. B. Einzel-Deployment / App-Build)
TENANT=musterstadt

# Vorschau anderer Gemeinden per ?gemeinde=<slug> auch in Produktion erlauben (nur Staging!)
# ALLOW_TENANT_PREVIEW=1

# Pflicht in Produktion: 32 Byte, Base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Speicherort für Vorgänge, Termine und Dokumente (verschlüsselt). Standard: ./.data
# DATA_DIR=/var/lib/buergerportal

# Öffentliche Adresse für Links in E-Mails/Webhooks ({gemeinde} wird ersetzt)
# PORTAL_URL=https://{gemeinde}.meinportal.de

# Optional eigenes Geheimnis für signierte Links/Sitzungen (sonst aus DATA_ENCRYPTION_KEY abgeleitet)
# SIGNING_SECRET=

# --- Dokumenten-Upload -----------------------------------------------------
# Virenscan: clamav (empfohlen, Pflicht in Produktion) | off (nur Entwicklung/Demo)
# Ohne Angabe werden Uploads in Produktion abgelehnt (fail closed).
# VIRUS_SCAN=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Dokumentart zusätzlich per Sprachmodell erkennen (nur mit ASSISTANT_PROVIDER=anthropic
# und Auftragsverarbeitungsvertrag). Standard: nur Stichwortsuche auf dem eigenen Server.
# DOKUMENT_KLASSIFIKATION=modell

# Geheimnisse für Webhook-Weiterleitungen (Name frei wählbar, siehe aemter[].weiterleitung.secretEnv)
# WEBHOOK_SECRET_STANDESAMT=

# --- Demo / Vorführung -----------------------------------------------------
# Schaltet Test-Online-Ausweis, Test-Bezahlung, Backoffice demo/demo und VIRUS_SCAN=off frei.
# NUR für Vorführungen mit Testdaten!
# DEMO_MODUS=1

# --- Bürgerkonto, Bezahlung, Push -------------------------------------------
# Zahlungsanbieter: demo (nur DEMO_MODUS) | epaybl
# ZAHLUNG_ANBIETER=epaybl
# Web Push (optional; sonst aus DATA_ENCRYPTION_KEY abgeleitet)
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Geheimnis für den täglichen Cron-Aufruf /api/cron (Vercel sendet es automatisch mit)
# CRON_SECRET=

# --- FIT-Connect (Übermittlung an Fachverfahren, pro Amt: weiterleitung { typ: "fitconnect", destinationId }) ---
# Zugangsdaten aus dem Self-Service-Portal der FITKO
# FIT_CONNECT_CLIENT_ID=
# FIT_CONNECT_CLIENT_SECRET=
# testing (Standard) | prod
# FIT_CONNECT_UMGEBUNG=testing
# Endpunkte – im Echtbetrieb (prod) PFLICHT, sie hängen vom Zustelldienst ab:
# FIT_CONNECT_TOKEN_URL=
# FIT_CONNECT_SUBMISSION_URL=

# --- Backoffice ------------------------------------------------------------
# Benutzer als JSON-Array. Eintrag erzeugen: npm run backoffice:benutzer -- anna musterstadt steueramt
# BACKOFFICE_USERS=[{"name":"anna","gemeinde":"musterstadt","aemter":["steueramt"],"hash":"scrypt$..."}]
# Demo-Zugang demo/demo auch in Produktion (NUR für Vorführungen mit Testdaten!)
# BACKOFFICE_DEMO=1

# --- Assistent -------------------------------------------------------------
# local              Standard. Kein Sprachmodell, keine Datenübermittlung.
# openai-compatible  EU-Anbieter (IONOS, STACKIT, Mistral …) oder eigenes Modell (vLLM/Ollama)
# anthropic          Claude über die Anthropic API
ASSISTANT_PROVIDER=local

# LLM_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=

# --- E-Mail ----------------------------------------------------------------
# console (Standard: nur Empfänger + Betreff ins Server-Log, nie Inhalte) | smtp
MAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
